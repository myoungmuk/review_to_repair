<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document mc:Ignorable="w14 w15 wp14" xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex"><w:body><w:p><w:pPr><w:spacing w:after="60"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">리뷰 기반 코드 수정에서 변경 위치 파악은 병목인가?</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="120"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">CodeReview-New 기반 파일럿 진단 연구</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="120"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:i/><w:iCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">Is Change Localisation a Bottleneck in Review-to-Repair? A Pilot Diagnostic Study on CodeReview-New</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:type="dxa" w:w="10772"/><w:tblBorders><w:top w:val="single" w:color="auto" w:sz="4"/><w:left w:val="single" w:color="auto" w:sz="4"/><w:bottom w:val="single" w:color="auto" w:sz="4"/><w:right w:val="single" w:color="auto" w:sz="4"/><w:insideH w:val="single" w:color="auto" w:sz="4"/><w:insideV w:val="single" w:color="auto" w:sz="4"/></w:tblBorders></w:tblPr><w:tblGrid><w:gridCol w:w="10772"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="10772"/><w:tcBorders><w:top w:val="single" w:color="000000" w:sz="2"/><w:left w:val="none"/><w:bottom w:val="single" w:color="000000" w:sz="2"/><w:right w:val="none"/></w:tcBorders><w:tcMar><w:top w:type="dxa" w:w="80"/><w:left w:type="dxa" w:w="0"/><w:bottom w:type="dxa" w:w="80"/><w:right w:type="dxa" w:w="0"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">요  약  </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">본 연구는 CodeReview-New의 100개 서브셋을 이용한 파일럿 실험을 통해 변경 위치 파악(change localisation)이 Review-to-Repair에서 주요 관련 요인으로 작용하는지 진단적으로 점검한다. no_review, direct, gold_location의 세 조건을 비교한 결과, direct는 no_review 대비 정확 수정률(exact_match_line_trim)을 0.00에서 0.04로 개선하였다. 반면 gold_location은 위치 중첩 성능(location_overlap_f1)을 0.622에서 0.727로 크게 향상시켰음에도 정확 수정률은 0.03에 머물렀다. 부트스트랩 분석에서 gold_location - direct의 정확 수정률 차이는 -0.010으로 95% 신뢰구간 [-0.040, 0.020]이 0을 포함하였다. 이는 위치 파악이 관련 요인임을 시사하지만, 그것만으로 최종 수정을 보장하지는 않음을 보여준다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="0"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="17"/><w:szCs w:val="17"/></w:rPr><w:t xml:space="preserve">키워드: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:sz w:val="17"/><w:szCs w:val="17"/></w:rPr><w:t xml:space="preserve">코드 리뷰, 자동 코드 수정, 대규모 언어모델, 변경 위치 파악, 프로그램 수리</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:spacing w:after="100"/></w:pPr><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:sectPr><w:pgSz w:w="11906" w:h="16838" w:orient="portrait"/><w:pgMar w:top="1701" w:right="567" w:bottom="1134" w:left="567" w:header="708" w:footer="708" w:gutter="0"/><w:pgNumType/><w:cols w:num="1"/><w:docGrid w:linePitch="360"/></w:sectPr></w:pPr></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="120"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">1. 서  론</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80" w:before="0"/><w:ind w:firstLine="360"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">코드 리뷰 환경에서는 개발자가 자연어 리뷰 코멘트를 바탕으로 코드를 재수정하는 과정이 반복된다. 최근 언어모델 기반 자동 코드 수정 연구는 이 과정을 자동화하려 하지만, 실패 원인이 리뷰 이해 부족인지, 수정 위치 탐지 실패인지, 혹은 패치 생성 실패인지는 충분히 분리 분석되지 않았다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80" w:before="0"/><w:ind w:firstLine="360"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">코드 리뷰 자동화 연구에서 Tufano et al.[1]은 코드 리뷰 데이터로 학습한 seq2seq 모델을 이용해 리뷰 코멘트 기반 코드 변경을 처음으로 자동화 과제로 정식화하고, 소규모 코드 변경에서의 초기 자동화 가능성을 보였다. Tufano et al.[2]은 사전학습 언어모델을 코드 리뷰 태스크에 적용하여 코드 정제를 포함한 여러 리뷰 관련 태스크에서의 활용 가능성을 탐색하였다. Li et al.[3]은 대규모 코드 리뷰 데이터를 활용한 다중 목표 사전학습 방식인 CodeReviewer를 제안하고, 리뷰 코멘트 생성·수정 품질 평가·코드 정제를 통합한 학습 체계를 구성하였다. 본 연구와 가장 가까운 선행 연구는 Review4Repair[4]로, 코드 리뷰 코멘트를 자동 프로그램 수리 과정에 직접 통합하여 리뷰 정보가 수리 성능에 미치는 영향을 탐구하였다. 그러나 이들 연구는 공통적으로 end-to-end 성능에 집중하며, 실패가 리뷰 이해·변경 위치 파악·편집 생성 중 어느 단계에서 비롯되는지를 분리 분석하지 않았다. 자동 프로그램 수리 연구[5]에서도 실패 요인 분해의 필요성이 논의되나, Review-to-Repair에 특화된 진단적 분석은 아직 부족하다. 본 연구는 end-to-end 성능 경쟁이 아니라 review understanding·change localisation·edit generation의 세 요인을 조건 통제로 분리하는 diagnostic pilot study라는 점에서 선행 연구와 차별화된다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80" w:before="0"/><w:ind w:firstLine="360"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">본 연구는 완성형 시스템 제안 대신 진단적 질문에 집중한다. 기여는 다음과 같다: (1) no_review / direct / gold_location의 3조건 진단 프로토콜 제안, (2) oracle 위치 정보가 위치 중첩 성능은 높이지만 정확 수정률은 개선하지 못한다는 초기 실증, (3) 소규모 오류 분석을 통한 잔여 실패 유형의 잠정적 논의. 단, 본 연구는 어느 단계가 지배적 병목인지를 확정하는 것이 아니라, 변경 위치 파악이 관련 요인으로 작용하는지를 파일럿 수준에서 점검하는 것임을 명확히 한다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60"/></w:pPr><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="120"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">2. 연구 질문</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">RQ1. </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">리뷰 코멘트는 no_review 대비 수정 성능을 높이는가?</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">RQ2. </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">oracle 위치 정보는 위치 파악 및 수정 성능을 높이는가?</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">RQ3. </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">위치 파악 성능 향상이 정확 수정 향상으로 이어지는가?</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">RQ4. </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">위치 정보 개선 후에도 남는 실패 유형은 무엇인가?</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60"/></w:pPr><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="120"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">3. 연구 설계</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="80"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">3.1 데이터 및 단위</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80" w:before="0"/><w:ind w:firstLine="360"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">실험 대상은 CodeReview-New로, 코드 스니펫/hunk 단위 벤치마크다. 따라서 gold_location은 full-file이 아닌 within-snippet localisation을 진단한다. 시드 42로 100개 예제를 추출하였으며, 각 예제는 수정 전 코드(old), 리뷰 코멘트(review), 정답 코드(new)로 구성된다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="80"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">3.2 비교 조건</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80" w:before="0"/><w:ind w:firstLine="360"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">no_review는 리뷰 코멘트 없이 코드만 제공하는 조건이다. direct는 코드와 리뷰 코멘트를 함께 제공한다. gold_location은 direct에 추가로 정답 변경 위치를 스니펫 내 마커로 표시한다. gold_location은 실제 배포 시스템이 아닌 위치 정보 상한 효과를 검사하는 oracle 진단 조건이다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="80"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">3.3 모델 및 평가</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80" w:before="0"/><w:ind w:firstLine="360"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">주 모델은 qwen2.5-coder:3b (Ollama, 결정론적 디코딩)이다. 강건성 확인을 위해 30개 서브셋에서 qwen2.5-coder:7b도 점검하였다. 평가 지표는 정확 수정 성능(exact_match_line_trim)과 위치 중첩 성능(location_overlap_f1)이며, 조건 간 차이는 paired bootstrap으로 95% 신뢰구간을 계산하였다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60"/></w:pPr><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="120"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="바탕" w:cs="바탕" w:eastAsia="바탕" w:hAnsi="바탕"/><w:b/><w:bCs/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve">4. 실험 결과</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="80"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="16"/><w:szCs w:val="16"/></w:rPr><w:t xml:space="preserve">표 1. Pilot 1 메인 결과 (Table 1. Main Results)</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:type="dxa" w:w="5300"/><w:tblBorders><w:top w:val="single" w:color="auto" w:sz="4"/><w:left w:val="single" w:color="auto" w:sz="4"/><w:bottom w:val="single" w:color="auto" w:sz="4"/><w:right w:val="single" w:color="auto" w:sz="4"/><w:insideH w:val="single" w:color="auto" w:sz="4"/><w:insideV w:val="single" w:color="auto" w:sz="4"/></w:tblBorders></w:tblPr><w:tblGrid><w:gridCol w:w="1900"/><w:gridCol w:w="1700"/><w:gridCol w:w="1700"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="1900"/><w:tcBorders><w:top w:val="single" w:color="444444" w:sz="1"/><w:left